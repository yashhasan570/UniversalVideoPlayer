_universalvideoplayer_options()
{
  if [ -z ${_universalvideoplayer_options_cache+x} ]; then
    _universalvideoplayer_options_cache=$(universalvideoplayer --no-config --list-options)
  fi
  echo "$_universalvideoplayer_options_cache"
}

_universalvideoplayer_get_args()
{
  local doc=$(_universalvideoplayer_options | grep -E "^\\s*$1\\s")
  local partial="$2"
  local type=$(echo "$doc" | awk '{print $2;}')

  # Complete aliases like their target (e.g. --sub-file -> --sub-files-append)
  local opt="$1"
  if [ "$type" = "alias" ]; then
    opt=--$(echo "$doc" | awk '{sub(/^--/, "", $4); print $4;}')
    doc=$(_universalvideoplayer_options | grep -E "^\\s*$opt\\s")
    type=$(echo "$doc" | awk '{print $2;}')
  fi
  # List actions are listed without a type; complete them like the list option
  if [ -z "$type" ]; then
    local list=$(echo "$opt" | sed -E 's/-(add|append|del|pre|remove|set|toggle)$//')
    if [ "$list" != "$opt" ]; then
      doc=$(_universalvideoplayer_options | grep -E "^\\s*$list\\s")
      type=$(echo "$doc" | awk '{print $2;}')
    fi
  fi

  # We special-case profiles to ensure we read the config
  if [ "$1" = "--show-profile" ]; then
    type="ShowProfile"
  elif [ "$1" = "--profile" ]; then
    type="Profile"
  elif [ "$1" = "--help" -o "$1" = "--h" ]; then
    # --help=<substring> filters by option name, not String values
    type="Help"
  fi

  declare -a candidates
  case $type in
    String)
      if echo "$doc" | grep -q '\[file\]' ; then
        if [ "$cur" = '=' ]; then
          # Without this, _filedir will try and complete files starting with '='
          cur=""
        fi
        _filedir 2>/dev/null || COMPREPLY=($(compgen -f))
        return 0
      else
        candidates=($(universalvideoplayer --no-config $1=help | grep -v ':' | awk '{print $1;}'))
        candidates+=("help")
      fi
      ;;
    Flag)
      candidates=("yes" "no" "help")
      ;;
    Choices:|Object)
      candidates=($(universalvideoplayer --no-config $1=help | grep -v ':' | awk '{print $1;}'))
      candidates+=("help")
      ;;
    Image)
      candidates=($(universalvideoplayer --no-config $1=help))
      candidates=("${candidates[@]:2}")
      candidates+=("help")
      ;;
    Profile)
      candidates=($(universalvideoplayer $1=help | grep -v ':' | awk '{print $1;}'))
      candidates+=("help")
      ;;
    ShowProfile)
      candidates=($(universalvideoplayer $1= | grep -v ':' | awk '{print $1;}'))
      ;;
    Help)
      # Mirror zsh help-options: bare option names (no "--"),
      # excluding no-* and *-(add|append|clr|pre|set|remove|toggle).
      candidates=($(_universalvideoplayer_options | awk '{print $1;}' | grep '^--' | \
        grep -vE '^--no-' | grep -vE '^--.*-(add|append|clr|pre|set|remove|toggle)$' | \
        sed 's/^--//'))
      ;;
    *)
      # There are other categories; some of which we could do something smarter
      # about, with enough work.
      ;;
  esac
  COMPREPLY=($(compgen -W "${candidates[*]}" -- "${partial}"))
  if [ ${#COMPREPLY[@]} -gt 1 ]; then
    compopt -o nospace universalvideoplayer
  fi
}

# Options where '=' is not appended:
#   - Print options and "not in config files" flags
#   - list-type sub-options with no argument (e.g. --af-clr, --vo-help)
# --help/--h are intentionally excluded (they take a substring filter).
_universalvideoplayer_special_regex='\s(Flag.*\[not in config files\]|Print)|^\s+--[[:alnum:]-]+-(clr|help)\s*$'
_universalvideoplayer_skip_regex='\sremoved \[deprecated\]'

_universalvideoplayer_regular_options()
{
  if [ -z ${_universalvideoplayer_regular_options_cache+x} ]; then
    _universalvideoplayer_regular_options_cache=($(_universalvideoplayer_options | grep -vE "$_universalvideoplayer_skip_regex" | \
      grep -vE "$_universalvideoplayer_special_regex" | awk '{print "\\"$1;}' | grep '\--'))
    _universalvideoplayer_regular_options_cache="${_universalvideoplayer_regular_options_cache[*]}"
  fi
  echo "$_universalvideoplayer_regular_options_cache"
}

_universalvideoplayer_special_options()
{
  if [ -z ${_universalvideoplayer_special_options_cache+x} ]; then
    _universalvideoplayer_special_options_cache=($(_universalvideoplayer_options | grep -vE "$_universalvideoplayer_skip_regex" | \
      grep -E "$_universalvideoplayer_special_regex" | awk '{print "\\"$1;}' | grep '\--'))
    _universalvideoplayer_special_options_cache="${_universalvideoplayer_special_options_cache[*]}"
  fi
  echo "$_universalvideoplayer_special_options_cache"
}

_universalvideoplayer()
{
  compopt +o nospace universalvideoplayer

  # _filedir requires the current candidate be in $cur
  local cur=${COMP_WORDS[COMP_CWORD]}
  local prev=${COMP_WORDS[((COMP_CWORD - 1))]}

  if [ "$cur" = '=' ]; then
     # If the current word is '=' then we are looking for an argument for the
     # option specified by the previous word.
    _universalvideoplayer_get_args "$prev"
  elif [ "$prev" = '=' ]; then
    # If the previous word is '=' then we are completing an argument for the
    # option specified by the word before the '='.
    local prevprev=${COMP_WORDS[((COMP_CWORD - 2))]}
    _universalvideoplayer_get_args "$prevprev" "$cur"
  else
    case $cur in
      -*)
        COMPREPLY=($(compgen -W "$(_universalvideoplayer_regular_options)" -S '=' -- "${cur}"))
        local normal_count=${#COMPREPLY[@]}
        COMPREPLY+=($(compgen -W "$(_universalvideoplayer_special_options)" -- "${cur}"))
        if [ $normal_count -gt 0 -o ${#COMPREPLY[@]} -gt 1 ]; then
          compopt -o nospace universalvideoplayer
        fi
        ;;
      *)
        _filedir 2>/dev/null || COMPREPLY=($(compgen -f))
        ;;
    esac
  fi
}

complete -F _universalvideoplayer universalvideoplayer
