#!/usr/bin/env python3

"""
This script emulates "unique application" functionality. When starting
playback with this script, it will try to reuse an already running instance of
universalvideoplayer (but only if that was started with uuniversalvideoplayer). Other universalvideoplayer instances (not started
by uuniversalvideoplayer) are ignored, and the script doesn't know about them.

This only takes filenames as arguments. Custom options can't be used; the script
interprets them as filenames. If universalvideoplayer is already running, the files passed to
uuniversalvideoplayer are appended to universalvideoplayer's internal playlist. If a file does not exist or is
otherwise not playable, universalvideoplayer will skip the playlist entry when attempting to
play it (from the GUI perspective, it's silently ignored).

If universalvideoplayer isn't running yet, this script will start universalvideoplayer and let it control the
current terminal. It will not write output to stdout/stderr, because this
will typically just fill ~/.xsession-errors with garbage.

universalvideoplayer will terminate if there are no more files to play, and running the uuniversalvideoplayer
script after that will start a new universalvideoplayer instance.

Note: you can supply custom universalvideoplayer path and options with the UNIVERSALVIDEOPLAYER environment
      variable. The environment variable will be split on whitespace, and the
      first item is used as path to universalvideoplayer binary and the rest is passed as options
      _if_ the script starts universalvideoplayer. If universalvideoplayer is not started by the script (i.e. universalvideoplayer
      is already running), this will be ignored.
"""

import os
import shlex
import socket
import string
import subprocess
import sys
from collections.abc import Iterable
from typing import BinaryIO


def is_url(filename: str) -> bool:
    parts = filename.split("://", 1)
    if len(parts) < 2:
        return False
    # protocol prefix has no special characters => it's an URL
    allowed_symbols = string.ascii_letters + string.digits + "_"
    prefix = parts[0]
    return all(c in allowed_symbols for c in prefix)

def get_socket_path() -> str:
    if os.name == "nt":
        return r"\\.\pipe\uuniversalvideoplayer"

    base_dir = (
        os.getenv("UUNIVERSALVIDEOPLAYER_SOCKET_DIR") or
        os.getenv("XDG_RUNTIME_DIR") or
        os.getenv("HOME") or
        os.getenv("TMPDIR")
    )

    if not base_dir:
        raise Exception("Could not determine a base directory for the socket. "
                        "Ensure that one of the following environment variables is set: "
                        "UUNIVERSALVIDEOPLAYER_SOCKET_DIR, XDG_RUNTIME_DIR, HOME or TMPDIR.")

    return os.path.join(base_dir, ".uuniversalvideoplayer")

def send_files_to_universalvideoplayer(conn: socket.socket | BinaryIO, files: Iterable[str]) -> None:
    try:
        send = conn.send if isinstance(conn, socket.socket) else conn.write
        for f in files:
            f = f.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
            send(f'raw loadfile "{f}" append-play\n'.encode())
    except Exception:
        print("universalvideoplayer is terminating or the connection was lost.", file=sys.stderr)
        sys.exit(1)

def start_universalvideoplayer(files: Iterable[str], socket_path: str) -> None:
    universalvideoplayer = "universalvideoplayer" if os.name != "nt" else "universalvideoplayer.exe"
    universalvideoplayer_command = shlex.split(os.getenv("UNIVERSALVIDEOPLAYER", universalvideoplayer))
    universalvideoplayer_command.extend([
        "--profile=builtin-pseudo-gui",
        f"--input-ipc-server={socket_path}",
        "--",
    ])
    universalvideoplayer_command.extend(files)
    subprocess.Popen(universalvideoplayer_command, start_new_session=True)

def main() -> None:
    files = (os.path.abspath(f) if not is_url(f) else f for f in sys.argv[1:])
    socket_path = get_socket_path()

    try:
        if os.name == "nt":
            with open(socket_path, "r+b", buffering=0) as pipe:
                send_files_to_universalvideoplayer(pipe, files)
        else:
            with socket.socket(socket.AF_UNIX) as sock:
                sock.connect(socket_path)
                send_files_to_universalvideoplayer(sock, files)
    except (FileNotFoundError, ConnectionRefusedError):
        start_universalvideoplayer(files, socket_path)

if __name__ == "__main__":
    main()
